# ═══════════════════════════════════════════════════════
#  Dia AI — Environment Variables
# ═══════════════════════════════════════════════════════
#
# 1. Bu faylni nusxalab .env deb saqlang
# 2. Firebase kalitlarini to'ldiring
#
# ── Gemini AI ──────────────────────────────────────────
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# ── Firebase (console.firebase.google.com) ─────────────
# Qadamlar:
#   1. Firebase Console → Project Settings
#   2. "Your apps" bo'limi → Web ikonkasi (</>)
#   3. App nomi: "Dia AI Web" → Register
#   4. Quyidagi kalitlarni nusxalab joylashtiring

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ── TextUP SMS Gateway (textup.uz) ─────────────────────
EXPO_PUBLIC_TEXTUP_EMAIL=your_email@domain.com
EXPO_PUBLIC_TEXTUP_PASSWORD=your_textup_password
EXPO_PUBLIC_TEXTUP_USER_ID=your_textup_user_id
EXPO_PUBLIC_TEXTUP_TEMPLATE_ID=your_textup_template_id
